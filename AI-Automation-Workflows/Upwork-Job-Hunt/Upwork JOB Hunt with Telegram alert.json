    {
      "parameters": {
        "jsCode": "// Normalise the Apify \"Upwork Job Scraper\" (neatrat) output into your sheet's\n// columns, capture the client's hourly/fixed budget, score against YOUR\n// keywords, and SKIP jobs already seen in previous runs (dedupe by URL).\n//\n// >>> EDIT THIS LIST to tune what gets you notified <<<\nconst KEYWORDS = [\n  'ai automation', 'automation specialist', 'automation engineer',\n  'ai engineer', 'ai agent', 'n8n', 'make.com', 'zapier',\n  'workflow automation', 'automation', 'lead generation', 'linkedin lead',\n  'rag', 'chatbot', 'openai', 'llm', 'gpt', 'integromat', 'claude'\n];\n\nconst norm = (s) => String(s).toLowerCase().replace(/[^a-z0-9]/g, '');\nfunction pick(obj, aliases, dflt = '') {\n  const map = {};\n  for (const k of Object.keys(obj || {})) map[norm(k)] = obj[k];\n  for (const a of aliases) {\n    const v = map[norm(a)];\n    if (v !== undefined && v !== null && v !== '') return v;\n  }\n  return dflt;\n}\n\n// run-sync returns one job per item; also handle a wrapped array just in case\nlet jobs = items.map((i) => i.json);\nif (jobs.length === 1) {\n  const only = jobs[0] || {};\n  const arr = only.items || only.response || only.data || only.results;\n  if (Array.isArray(arr)) jobs = arr;\n}\n\nconst now = new Date().toISOString();\n\n// build normalised rows\nconst rows = jobs.filter((j) => j && Object.keys(j).length).map((j) => {\n  const title = pick(j, ['title', 'jobTitle', 'name']);\n  const url   = pick(j, ['url', 'jobUrl', 'link', 'jobLink', 'ciphertext']);\n  const date  = pick(j, ['postedTime','postedOn','postedDate','publishedDate','publishDate','createdAt','time','date','postingTime']);\n  const description = pick(j, ['description', 'jobDescription', 'snippet']);\n  const skills = pick(j, ['skills', 'tags', 'requiredSkills', 'category'], '');\n  const location = pick(j, ['clientCountry','clientLocation','country','location']);\n  const experience = pick(j, ['experienceLevel','experience','contractorTier','tier','difficulty']);\n\n  // ---- client's budget: hourly range OR fixed price ----\n  let salary = pick(j, ['hourlyRate','hourlyBudget','budget','fixedPrice','fixedBudget','projectBudget','amount','salary','rate','price']);\n  const hMin = pick(j, ['hourlyRateMin','hourlyBudgetMin','minHourlyRate','rateMin']);\n  const hMax = pick(j, ['hourlyRateMax','hourlyBudgetMax','maxHourlyRate','rateMax']);\n  if (salary && typeof salary === 'object') {\n    const mn = salary.min ?? salary.minAmount ?? salary.rateMin ?? salary.hourlyMin;\n    const mx = salary.max ?? salary.maxAmount ?? salary.rateMax ?? salary.hourlyMax;\n    const amt = salary.amount ?? salary.value ?? salary.fixed;\n    if (mn || mx) salary = `$${mn ?? '?'} - $${mx ?? '?'}/hr`;\n    else if (amt) salary = `$${amt}`;\n    else salary = JSON.stringify(salary);\n  }\n  if (!salary && (hMin || hMax)) salary = `$${hMin || '?'} - $${hMax || '?'}/hr`;\n\n  const jt = String(pick(j, ['jobType','contractType','type','paymentType'])).toLowerCase();\n  const paymentType = /hour/.test(jt) ? 'Hourly' : /fixed/.test(jt) ? 'Fixed'\n                    : (/\\/hr/i.test(String(salary)) ? 'Hourly' : '');\n\n  const skillsText = Array.isArray(skills) ? skills.join(', ') : String(skills);\n\n  // ---- keyword-based match score (0-100) ----\n  const text = (title + ' ' + description + ' ' + skillsText).toLowerCase();\n  const matched = KEYWORDS.filter((k) => text.includes(k));\n  let score = 20;\n  score += Math.min(matched.length, 5) * 14;   // up to +70\n  const amount = parseFloat((String(salary).match(/[\\d,.]+/) || ['0'])[0].replace(/,/g, ''));\n  if (amount >= 1000) score += 10;\n  if (score > 100) score = 100;\n\n  return { json: {\n    Title: title, URL: url, Date: date, Found: now,\n    Description: description, Salary: salary, 'Payment Type': paymentType,\n    Location: location, Experience: experience,\n    Status: 'New', Message: matched.join(', '),\n    Score: score,\n  }};\n});\n\n// ---- SKIP jobs already seen in previous runs (persisted across executions) ----\nconst store = $getWorkflowStaticData('global');\nstore.seenUrls = store.seenUrls || [];\nconst seen = new Set(store.seenUrls);\nconst fresh = rows.filter((r) => r.json.URL && !seen.has(r.json.URL));\nfor (const r of fresh) store.seenUrls.push(r.json.URL);\nif (store.seenUrls.length > 5000) store.seenUrls = store.seenUrls.slice(-5000); // cap growth\n\nreturn fresh;\n"
      },
