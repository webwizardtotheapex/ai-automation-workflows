      "parameters": {
        "jsCode": "// Get subject and From field\nconst subject = $input.first().json.Subject || $input.first().json.subject || \"\";\nconst from = $input.first().json.From || $input.first().json.from || \"\";\n\n// Get full name from From field: \"Timothy Anthony via LinkedIn <email>\"\nconst fullName = from.split(\" via LinkedIn\")[0].trim();\n\n// Get first name from subject as backup\nconst subjectName = subject.split(\" accepted your invitation\")[0].trim();\n\n// Use From field name (more complete) or subject name as fallback\nconst name = fullName || subjectName;\nconst nameParts = name.split(\" \");\nconst firstName = nameParts[0];\nconst lastName = nameParts.slice(1).join(\" \");\n\nreturn [{\n  json: {\n    full_name: name,\n    first_name: firstName,\n    last_name: lastName,\n    original_subject: subject\n  }\n}];"
      },
