      "parameters": {
        "formTitle": "Daniel Okafor Logistics Career Application Portal",
        "formDescription": "Thank you for your interest in joining Daniel Okafor Logistics. Please complete this application form with accurate and up-to-date information.\n\nOnce your application is submitted, you will receive an automatic confirmation email acknowledging receipt of your application. Our HR team will carefully review all submissions, and qualified candidates will be contacted via email with an interview invitation.\n\nFields marked with (*) are required.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Full Name",
              "requiredField": true
            },
            {
              "fieldLabel": "Email Address",
              "fieldType": "email",
              "requiredField": true
            },
            {
              "fieldLabel": "Phone Number",
              "fieldType": "number",
              "requiredField": true
            },
            {
              "fieldLabel": "Position Applying For",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Operations Officer"
                  },
                  {
                    "option": "Customer Service Representative"
                  },
                  {
                    "option": "Logistics Coordinator"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Years Of Experience",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "0–2 years"
                  },
                  {
                    "option": "3–5 years"
                  },
                  {
                    "option": "6+ years"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Current Location",
              "placeholder": "e.g., Lagos, Nigeria"
            },
            {
              "fieldLabel": "Upload Your CV/Resume",
              "fieldType": "file",
              "acceptFileTypes": "pdf",
              "requiredField": true
            },
            {
              "fieldLabel": "Portfolio or Professional Profile Link (Optional)",
              "placeholder": "Share a link to your GitHub, LinkedIn, personal website, Behance, Google Drive portfolio, or other professional profile."
            },
            {
              "fieldLabel": "Why Do You Want This Role",
              "fieldType": "textarea"
            }
          ]
        },
        "options": {
          "appendAttribution": false,
          "customCss": ":root {\n    /* Typography */\n    --font-family: 'Inter', 'Segoe UI', sans-serif;\n    --font-weight-normal: 400;\n    --font-weight-bold: 600;\n\n    --font-size-body: 14px;\n    --font-size-label: 15px;\n    --font-size-test-notice: 13px;\n    --font-size-input: 15px;\n    --font-size-header: 30px;\n    --font-size-subheader: 16px;\n    --font-size-paragraph: 15px;\n    --font-size-link: 14px;\n    --font-size-error: 13px;\n\n    --font-size-html-h1: 34px;\n    --font-size-html-h2: 28px;\n    --font-size-html-h3: 22px;\n    --font-size-html-h4: 18px;\n    --font-size-html-h5: 16px;\n    --font-size-html-h6: 14px;\n\n    /* Background */\n    --color-background: #f4f7fb;\n\n    /* Card */\n    --color-card-bg: #ffffff;\n    --color-card-border: #e5e7eb;\n    --color-card-shadow: rgba(15, 23, 42, 0.08);\n\n    /* Text */\n    --color-header: #111827;\n    --color-header-subtext: #6b7280;\n    --color-label: #374151;\n    --color-html-text: #374151;\n\n    /* Links */\n    --color-link: #2563eb;\n    --color-html-link: #2563eb;\n\n    /* Inputs */\n    --color-input-border: #d1d5db;\n    --color-input-text: #111827;\n    --color-focus-border: #2563eb;\n\n    /* Button */\n    --color-submit-btn-bg: #2563eb;\n    --color-submit-btn-text: #ffffff;\n\n    /* Validation */\n    --color-required: #ef4444;\n    --color-error: #dc2626;\n\n    /* Test Notice */\n    --color-test-notice-bg: #eff6ff;\n    --color-test-notice-border: #bfdbfe;\n    --color-test-notice-text: #1d4ed8;\n\n    /* Clear Button */\n    --color-clear-button-bg: #6b7280;\n\n    /* Radius */\n    --border-radius-card: 16px;\n    --border-radius-input: 12px;\n    --border-radius-clear-btn: 50%;\n    --card-border-radius: 16px;\n\n    /* Padding */\n    --padding-container-top: 40px;\n    --padding-card: 32px;\n    --padding-form-input: 14px;\n    --padding-test-notice-horizontal: 24px;\n    --padding-test-notice-vertical: 14px;\n\n    --margin-bottom-card: 24px;\n    --card-padding: 32px;\n    --card-margin-bottom: 24px;\n\n    /* Width */\n    --container-width: 640px;\n    --submit-btn-height: 54px;\n\n    /* Misc */\n    --checkbox-size: 20px;\n    --box-shadow-card: 0 10px 35px rgba(15,23,42,.08);\n    --opacity-placeholder: .65;\n}"
